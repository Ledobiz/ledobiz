# Copy to .env.local and fill in. Never commit real values.

# Neon (or any PostgreSQL) connection string. Use the pooled URL from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# OpenAI, for AI-drafted emails. Leave empty to write emails by hand.
OPENAI_API_KEY=""
# Optional: defaults to gpt-5.4-mini
OPENAI_MODEL=""

# Brevo sends all emails. Create the key under Brevo → SMTP & API → API keys.
# The sender addresses (hello@ and accounts@ledobiz.com by default) are set in Settings and
# must be verified senders in Brevo. Leave empty to only save emails to the history.
BREVO_API_KEY=""

# Alternative to Brevo's API: any SMTP server (used only when BREVO_API_KEY is empty).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Public address of this site, used in payment links and provider redirects.
APP_URL="https://ledobiz.com"

# Online invoice payments. Leave a key empty to hide that option on the payment page.
# Paystack: Settings → API Keys & Webhooks. Webhook URL: {APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""
# Flutterwave: Settings → API Keys. Webhook URL: {APP_URL}/api/webhooks/flutterwave,
# and set the same "secret hash" here.
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# OneSignal web push: new quote requests alert admins' phones and browsers (no app to install).
# OneSignal → New app → Web → Custom Code, site URL = APP_URL. Keys under Settings → Keys & IDs.
# Each admin turns alerts on per device in Settings → Push alerts. Leave empty to skip push.
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# Cloudflare Turnstile bot check on the quote form. Cloudflare → Turnstile → Add widget,
# hostname ledobiz.com, Managed mode. Leave both empty to skip the check (local development).
# The site key is built into the page, so redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Protects the daily email job (/api/cron/daily). Vercel Cron sends it automatically;
# any other scheduler must call the URL with the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Google Search Console → Add property → "HTML tag" method: paste only the content="…" value.
GOOGLE_SITE_VERIFICATION=""

# First admin account, created by `npm run db:seed`.
ADMIN_NAME="Ledobiz Admin"
ADMIN_EMAIL="admin@ledobiz.com"
ADMIN_PASSWORD=""

# Set to 1 to also load demo clients, projects and invoices when seeding.
SEED_DEMO="0"
